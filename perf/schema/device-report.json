{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Phoenix device report, version 1: the phone's fundamentals and the micro-benchmarks",
  "type": "object",
  "required": ["report_version", "step", "commit", "device", "pool", "core_rates", "barrier_ns", "gathers", "sweep_bytes_per_s", "micro", "targets"],
  "additionalProperties": false,
  "properties": {
    "report_version": { "type": "integer", "enum": [1] },
    "step": { "type": "string" },
    "commit": { "type": "string" },
    "device": {
      "type": "object",
      "required": ["manufacturer", "model", "soc", "android_sdk", "total_ram_bytes", "app_version", "started_at"],
      "additionalProperties": false,
      "properties": {
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "soc": { "type": "string" },
        "android_sdk": { "type": "integer", "minimum": 0 },
        "total_ram_bytes": { "type": "integer", "minimum": 0 },
        "app_version": { "type": "string" },
        "started_at": { "type": "string" }
      }
    },
    "pool": {
      "type": "object",
      "required": ["cores", "pinned", "unpinned"],
      "additionalProperties": false,
      "properties": {
        "cores": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "pinned": { "type": "boolean" },
        "unpinned": { "type": "integer", "minimum": 0 }
      }
    },
    "core_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "thermal_status", "pool_fast_core_seconds_per_s", "cores"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string" },
          "thermal_status": { "type": "integer" },
          "pool_fast_core_seconds_per_s": { "type": ["number", "null"], "minimum": 0 },
          "cores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["core", "capacity", "in_pool", "alone_units_per_s", "loaded_units_per_s"],
              "additionalProperties": false,
              "properties": {
                "core": { "type": "integer", "minimum": 0 },
                "capacity": { "type": ["integer", "null"], "minimum": 0 },
                "in_pool": { "type": "boolean" },
                "alone_units_per_s": { "type": "integer", "minimum": 0 },
                "loaded_units_per_s": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "barrier_ns": { "type": ["integer", "null"], "minimum": 0 },
    "gathers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bytes", "prefetch", "rows", "ns_per_row", "core_ns_per_row", "page_size"],
        "additionalProperties": false,
        "properties": {
          "bytes": { "type": "integer", "minimum": 0 },
          "prefetch": { "type": "boolean" },
          "rows": { "type": "integer", "minimum": 0 },
          "ns_per_row": { "type": "integer", "minimum": 0 },
          "core_ns_per_row": { "type": "integer", "minimum": 0 },
          "page_size": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "sweep_bytes_per_s": { "type": ["integer", "null"], "minimum": 0 },
    "micro": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ns_per_op", "ops"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "ns_per_op": { "type": "integer", "minimum": 0 },
          "ops": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "name", "value", "target", "verdict", "thermal_status"],
        "additionalProperties": false,
        "properties": {
          "section": { "type": "string" },
          "name": { "type": "string" },
          "value": { "type": "string" },
          "target": { "type": "string" },
          "verdict": { "type": "string", "enum": ["met", "missed", ""] },
          "thermal_status": { "type": "integer" }
        }
      }
    }
  }
}
