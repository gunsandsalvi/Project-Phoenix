{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Phoenix device report: version 1, the phone's fundamentals and the micro-benchmarks; version 2 adds the world's turns and the full-load bench",
  "type": "object",
  "required": [
    "report_version",
    "step",
    "commit",
    "device",
    "pool",
    "core_rates",
    "barrier_ns",
    "gathers",
    "sweep_bytes_per_s",
    "micro",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "report_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "step": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "device": {
      "type": "object",
      "required": [
        "manufacturer",
        "model",
        "soc",
        "android_sdk",
        "total_ram_bytes",
        "app_version",
        "started_at"
      ],
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "soc": {
          "type": "string"
        },
        "android_sdk": {
          "type": "integer",
          "minimum": 0
        },
        "total_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "app_version": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      }
    },
    "pool": {
      "type": "object",
      "required": [
        "cores",
        "pinned",
        "unpinned"
      ],
      "additionalProperties": false,
      "properties": {
        "cores": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pinned": {
          "type": "boolean"
        },
        "unpinned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "core_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "thermal_status",
          "pool_fast_core_seconds_per_s",
          "cores"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "thermal_status": {
            "type": "integer"
          },
          "pool_fast_core_seconds_per_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "core",
                "capacity",
                "in_pool",
                "alone_units_per_s",
                "loaded_units_per_s"
              ],
              "additionalProperties": false,
              "properties": {
                "core": {
                  "type": "integer",
                  "minimum": 0
                },
                "capacity": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "in_pool": {
                  "type": "boolean"
                },
                "alone_units_per_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "loaded_units_per_s": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "barrier_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gathers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bytes",
          "prefetch",
          "rows",
          "ns_per_row",
          "core_ns_per_row",
          "page_size"
        ],
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "prefetch": {
            "type": "boolean"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "ns_per_row": {
            "type": "integer",
            "minimum": 0
          },
          "core_ns_per_row": {
            "type": "integer",
            "minimum": 0
          },
          "page_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "sweep_bytes_per_s": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "micro": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ns_per_op",
          "ops"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "ns_per_op": {
            "type": "integer",
            "minimum": 0
          },
          "ops": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "name",
          "value",
          "target",
          "verdict",
          "thermal_status"
        ],
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "met",
              "missed",
              ""
            ]
          },
          "thermal_status": {
            "type": "integer"
          }
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "report_version",
        "commit",
        "opening_ms",
        "opening_vm_hwm_bytes",
        "settling",
        "turns",
        "median_turn_ms",
        "worst_turn_ms",
        "vm_hwm_bytes",
        "world_hash",
        "findings",
        "reads",
        "drift",
        "save"
      ],
      "additionalProperties": false,
      "properties": {
        "report_version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "commit": {
          "type": "string"
        },
        "opening_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "opening_vm_hwm_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "settling": {
          "type": "object",
          "required": [
            "years",
            "turns",
            "days",
            "wall_ms",
            "vm_hwm_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "years": {
              "type": "integer",
              "minimum": 0
            },
            "turns": {
              "type": "integer",
              "minimum": 0
            },
            "days": {
              "type": "integer",
              "minimum": 0
            },
            "wall_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "vm_hwm_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "turn",
              "first_day",
              "days",
              "business",
              "wall_ms",
              "substeps",
              "vm_hwm_bytes",
              "pss_bytes",
              "thermal_status"
            ],
            "additionalProperties": false,
            "properties": {
              "turn": {
                "type": "integer",
                "minimum": 0
              },
              "first_day": {
                "type": "integer",
                "minimum": 0
              },
              "days": {
                "type": "integer",
                "minimum": 0
              },
              "business": {
                "type": "boolean"
              },
              "wall_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "substeps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "substep",
                    "wall_ns"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "substep": {
                      "type": "string"
                    },
                    "wall_ns": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              },
              "vm_hwm_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "pss_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "thermal_status": {
                "type": "integer"
              }
            }
          }
        },
        "median_turn_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "worst_turn_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "vm_hwm_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "world_hash": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "reads": {
          "type": "object"
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "day",
              "distance"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "day": {
                "type": "integer",
                "minimum": 0
              },
              "distance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "save": {
          "type": "object",
          "required": [
            "save_ms",
            "save_bytes",
            "load_ms",
            "hash_holds"
          ],
          "additionalProperties": false,
          "properties": {
            "save_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "save_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "load_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "hash_holds": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "load": {
      "type": "object",
      "required": [
        "load_version",
        "commit",
        "population_cells",
        "population_members_per_cell",
        "population_profile_entries_per_cell",
        "built_ms",
        "built_vm_hwm_bytes",
        "days",
        "turn_ms",
        "median_turn_ms",
        "worst_turn_ms",
        "vm_hwm_bytes",
        "pss_bytes",
        "saves",
        "criteria",
        "stores",
        "works"
      ],
      "additionalProperties": false,
      "properties": {
        "load_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "commit": {
          "type": "string"
        },
        "population_cells": {
          "type": "integer",
          "minimum": 0
        },
        "population_members_per_cell": {
          "type": "integer",
          "minimum": 0
        },
        "population_profile_entries_per_cell": {
          "type": "integer",
          "minimum": 0
        },
        "built_ms": {
          "type": "integer",
          "minimum": 0
        },
        "built_vm_hwm_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "type",
              "ms",
              "works"
            ],
            "additionalProperties": false,
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "business",
                  "closed",
                  "heavy"
                ]
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              },
              "works": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "work",
                    "ms"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "work": {
                      "type": "string"
                    },
                    "ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "turn_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "median_turn_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "worst_turn_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "vm_hwm_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pss_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "saves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "after_day",
              "ms",
              "bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "after_day": {
                "type": "integer",
                "minimum": 0
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "criteria": {
          "type": "object",
          "required": [
            "median_turn_ms",
            "worst_turn_ms",
            "memory_bytes",
            "save_ms",
            "two_saves_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "median_turn_ms": {
              "type": "integer",
              "minimum": 0
            },
            "worst_turn_ms": {
              "type": "integer",
              "minimum": 0
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "save_ms": {
              "type": "integer",
              "minimum": 0
            },
            "two_saves_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "line",
              "bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "works": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "line"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "line": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
