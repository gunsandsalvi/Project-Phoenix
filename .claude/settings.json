{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -Rs --rawfile card \"${CLAUDE_PROJECT_DIR:-.}/.claude/rules-card.md\" '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:$card}}' 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Rules card"
          }
        ]
      }
    ]
  }
}
